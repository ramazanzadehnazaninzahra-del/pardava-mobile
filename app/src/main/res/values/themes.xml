<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight parent lets the window background follow dark mode while
         Compose owns the real colors; edge-to-edge is handled in MainActivity. -->
    <style name="Theme.Pardava" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
