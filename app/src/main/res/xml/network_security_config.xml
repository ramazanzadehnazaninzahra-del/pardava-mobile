<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- v0.4.1: cleartext is allowed app-wide so the installable demo can reach the
         self-hosted FastAPI backend over plain HTTP on a LAN (e.g. http://192.168.x.x:8100).
         HTTPS endpoints are unaffected and remain the recommended production setup. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
